<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Account Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="帳號"
            android:textSize="13sp"
            android:textColor="@color/tiffany_green"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="尚未登入"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本地模式"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/sign_out"
                android:textSize="12sp"
                android:backgroundTint="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Health Connect Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="健康連線"
            android:textSize="13sp"
            android:textColor="@color/tiffany_green"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sync_steps_distance"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHealthSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvHcStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="檢查中..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/test_connection"
                    android:textSize="12sp"
                    android:backgroundTint="@color/tiffany_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Movement Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="移動設定"
            android:textSize="13sp"
            android:textColor="@color/champagne_gold"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/step_length"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/tvStepLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.75 m"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tiffany_green" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekStepLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="5"
                android:progressTint="@color/tiffany_green"
                android:thumbTint="@color/tiffany_green"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/movement_speed"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/tvMovementSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 km/h"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tiffany_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- About -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textSize="13sp"
            android:textColor="@color/champagne_gold"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS Walker v1.1.0"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
